<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- PendantClient restricts HTTP to an explicitly accepted private IP.
         A domain-config cannot express the private IPv4 address ranges. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
