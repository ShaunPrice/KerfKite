#!/usr/bin/python3
"""GTK Studio workbench. Uses the distribution's GTK 3 and WebKitGTK bindings."""

import json
import os
from pathlib import Path
import stat
import sys
import tempfile
from urllib.parse import urlsplit

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
try:
    gi.require_version("WebKit2", "4.1")
except ValueError:
    gi.require_version("WebKit2", "4.0")
from gi.repository import Gdk, GLib, Gtk, WebKit2


TABS = ("Design", "Objects", "Properties", "Layers", "Text", "Images", "Templates",
        "3D CAD", "CAM", "3D relief", "Rotary", "Control", "Projects", "Quote", "Help")
PROJECT_LIMIT = 4_000_000


def studio_url(url):
    parts = urlsplit(url)
    if (parts.scheme != "http" or parts.hostname != "127.0.0.1" or not parts.port
            or parts.netloc != f"127.0.0.1:{parts.port}" or parts.path not in ("", "/")
            or parts.query or parts.fragment):
        raise ValueError("The desktop workspace requires a local Studio URL.")
    return f"http://{parts.netloc}/"


def atomic_write(path, content):
    path = Path(path)
    old_mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else None
    # Keep the temporary file on the same filesystem so a failed save preserves the old project.
    with tempfile.NamedTemporaryFile("w", dir=path.parent, encoding="utf-8",
                                     newline="", delete=False) as output:
        temporary = Path(output.name)
        try:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
            if old_mode is not None:
                os.fchmod(output.fileno(), old_mode)
            output.close()
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


class Workbench(Gtk.Window):
    def __init__(self, url):
        super().__init__(title="KerfKite Studio")
        self.url = studio_url(url)
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor(0)
        workarea = monitor.get_workarea()
        self.set_default_size(min(1360, workarea.width), min(850, workarea.height))
        self.set_position(Gtk.WindowPosition.CENTER)
        self.busy = False
        self.polling = False
        self.revision = 0
        self.generation = 0
        self.loaded = False
        self.destroyed = False
        self.syncing = False
        self.last = {}
        self.document = None
        self.path = None
        self.active_popups = set()
        self.accels = Gtk.AccelGroup()
        self.add_accel_group(self.accels)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(outer)
        outer.pack_start(self.menu_bar(), False, False, 0)
        outer.pack_start(self.toolbar(), False, False, 0)
        split = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        outer.pack_start(split, True, True, 0)
        self.inspector = Gtk.ScrolledWindow()
        self.inspector.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.inspector.set_min_content_width(218)
        self.inspector.add(self.build_inspector())
        self.inspector.set_no_show_all(workarea.width < 1024)
        if workarea.width < 1024:
            self.inspector.get_child().show_all()
        split.pack1(self.inspector, resize=False, shrink=False)
        self.view = WebKit2.WebView()
        self.view.connect("decide-policy", self.policy)
        self.view.connect("create", self.popup)
        self.view.connect("load-changed", self.loaded_page)
        self.view.connect("web-process-terminated", self.terminated)
        self.view.get_context().connect("download-started", self.download)
        split.pack2(self.view, resize=True, shrink=True)
        self.status = Gtk.Label(label="Opening Studio…", xalign=0)
        self.status.set_margin_start(8)
        self.status.set_margin_end(8)
        outer.pack_end(self.status, False, False, 3)
        self.connect("delete-event", self.close_requested)
        self.connect("destroy", self.on_destroy)
        self.view.load_uri(self.url)
        self.timer = GLib.timeout_add(800, self.refresh)

    def menu_bar(self):
        bar = Gtk.MenuBar()
        def menu(name, items):
            top = Gtk.MenuItem.new_with_mnemonic(name)
            submenu = Gtk.Menu()
            top.set_submenu(submenu)
            bar.append(top)
            for label, key, callback in items:
                item = Gtk.MenuItem.new_with_mnemonic(label)
                item.connect("activate", lambda _, fn=callback: fn())
                if key:
                    keyval, keymod = Gtk.accelerator_parse(key)
                    item.add_accelerator("activate", self.accels, keyval, keymod, Gtk.AccelFlags.VISIBLE)
                submenu.append(item)
        menu("_File", [("_New project", "<Ctrl>n", self.new), ("_Open project…", "<Ctrl>o", self.open),
                       ("_Save project", "<Ctrl>s", self.save), ("Save _as…", "<Ctrl><Shift>s", lambda: self.save(True)),
                       ("_Export G-code…", None, self.export), ("_Close", "<Ctrl>w", self.close)])
        menu("_Edit", [("_Undo", "<Ctrl>z", lambda: self.command("undo")),
                       ("_Redo", "<Ctrl><Shift>z", lambda: self.command("redo"))])
        menu("_Workspace", [("CAD _command…", "<Ctrl><Shift>k", lambda: self.open_authoring("command-line")),
                            ("CAD _script…", None, lambda: self.open_authoring("script-editor"))] +
             [(tab, None, lambda tab=tab: self.command("tab", {"name": tab})) for tab in TABS])
        return bar

    def toolbar(self):
        bar = Gtk.Toolbar()
        bar.set_style(Gtk.ToolbarStyle.BOTH_HORIZ)
        for icon, label, callback in (
                ("document-open-symbolic", "Open", self.open), ("document-save-symbolic", "Save", self.save),
                ("edit-undo-symbolic", "Undo", lambda: self.command("undo")),
                ("edit-redo-symbolic", "Redo", lambda: self.command("redo")),
                ("media-playback-start-symbolic", "Preview", lambda: self.command("preview")),
                ("view-dual-symbolic", "Inspector", lambda: self.inspector.set_visible(not self.inspector.get_visible()))):
            button = Gtk.ToolButton()
            button.set_icon_name(icon)
            button.set_label(label)
            button.set_tooltip_text(label)
            button.set_is_important(True)
            button.connect("clicked", lambda _, fn=callback: fn())
            bar.insert(button, -1)
        return bar

    def build_inspector(self):
        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7, margin=10)
        def heading(title):
            label = Gtk.Label(xalign=0)
            label.set_markup("<b>" + title + "</b>")
            panel.pack_start(label, False, False, 0)
        heading("Objects")
        self.store = Gtk.ListStore(int, str)
        tree = Gtk.TreeView(model=self.store)
        tree.set_headers_visible(False)
        tree.set_search_column(1)
        tree.append_column(Gtk.TreeViewColumn("Object", Gtk.CellRendererText(), text=1))
        self.selection = tree.get_selection()
        self.selection.connect("changed", self.select_object)
        scroller = Gtk.ScrolledWindow()
        scroller.set_shadow_type(Gtk.ShadowType.IN)
        scroller.set_min_content_height(80)
        scroller.add(tree)
        panel.pack_start(scroller, True, True, 0)

        def fields(labels, values):
            grid = Gtk.Grid(column_spacing=8, row_spacing=3)
            panel.pack_start(grid, False, False, 0)
            spins = []
            for row, (label, initial) in enumerate(zip(labels, values)):
                spin = Gtk.SpinButton.new_with_range(0, 100000, 0.1)
                spin.set_digits(3)
                spin.set_value(initial)
                spin.set_hexpand(True)
                caption = Gtk.Label(label=label + " (mm)", xalign=0)
                grid.attach(caption, 0, row, 1, 1)
                grid.attach(spin, 1, row, 1, 1)
                spins.append(spin)
            return spins

        def button(label, fn):
            b = Gtk.Button(label=label)
            b.connect("clicked", lambda _: fn())
            panel.pack_start(b, False, False, 0)
            return b

        heading("Selection")
        self.properties = Gtk.Label(label="Select an object", xalign=0)
        self.properties.set_line_wrap(True)
        panel.pack_start(self.properties, False, False, 0)
        self.move_x, self.move_y = fields(("X", "Y"), (0, 0))
        self.move_button = button("Move selection", self.move_selected)
        heading("Add a shape")
        self.kind = Gtk.ComboBoxText()
        for name in ("Rectangle", "Ellipse", "Line"):
            self.kind.append(name.lower(), name)
        self.kind.set_active(0)
        panel.pack_start(self.kind, False, False, 0)
        self.shape_x, self.shape_y, self.shape_w, self.shape_h = fields(
            ("X", "Y", "Width", "Height"), (10, 10, 40, 20))
        self.add_button = button("Add shape", self.add_shape)
        return panel

    def add_shape(self):
        self.command("shape", dict(kind=self.kind.get_active_id(), x=self.shape_x.get_value(),
                                   y=self.shape_y.get_value(), width=self.shape_w.get_value(),
                                   height=self.shape_h.get_value()))

    def move_selected(self):
        self.command("move", dict(x=self.move_x.get_value(), y=self.move_y.get_value()))

    def select_object(self, selection):
        model, it = selection.get_selected()
        if not self.syncing and it is not None:
            self.command("select", {"index": model[it][0]})

    def trusted(self):
        return self.loaded and self.view.get_uri() == self.url and not self.destroyed

    def policy(self, view, decision, typ):
        if typ not in (WebKit2.PolicyDecisionType.NAVIGATION_ACTION, WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION):
            return False
        action = decision.get_navigation_action()
        uri = action.get_request().get_uri()
        # The browser editor exports vectors, meshes and reports through Blob downloads.
        # Take the download path explicitly so these documents never replace the workbench.
        if (typ == WebKit2.PolicyDecisionType.NAVIGATION_ACTION
                and (uri.startswith("blob:" + self.url) or uri.startswith("data:"))):
            decision.download()
            return True
        # New views never receive native commands. Permit only local Studio pages and its print window.
        if typ == WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION or view != self.view:
            allowed = self.auxiliary_uri(uri)
        else:
            allowed = uri == self.url
        if not allowed:
            decision.ignore()
            return True
        return False

    def auxiliary_uri(self, uri):
        if uri in ("", "about:blank"):
            return True
        try:
            parts = urlsplit(uri)
            return parts.scheme == "http" and parts.netloc == urlsplit(self.url).netloc
        except ValueError:
            return False

    def popup(self, parent, action):
        uri = action.get_request().get_uri()
        if not self.auxiliary_uri(uri):
            return None
        child = WebKit2.WebView.new_with_related_view(parent)
        win = Gtk.Window(title="KerfKite Studio", transient_for=self)
        win.set_default_size(950, 700)
        win.add(child)
        child.connect("decide-policy", self.policy)
        child.connect("ready-to-show", lambda *_: win.show_all())
        child.connect("close", lambda *_: win.destroy())
        self.active_popups.add(win)
        win.connect("destroy", lambda *_: self.active_popups.discard(win))
        return child

    def loaded_page(self, _, event):
        if event == WebKit2.LoadEvent.STARTED:
            self.generation += 1
            self.loaded = False
            self.path = self.document = None
        elif event == WebKit2.LoadEvent.FINISHED:
            self.loaded = self.view.get_uri() == self.url
            self.refresh()

    def terminated(self, *_):
        self.loaded = False
        self.generation += 1
        self.status.set_text("The workspace stopped responding. Reopen Studio to recover.")

    def js(self, action, payload, done, pending=False):
        if not self.trusted():
            done(None, "Studio is unavailable.")
            return
        generation = self.generation
        args = json.dumps([action, payload], ensure_ascii=True)
        script = ("(()=>{if(window!==window.top || location.href!==" + json.dumps(self.url) +
                  " || !window.KerfKiteDesktop)return null;return window.KerfKiteDesktop.dispatch(..." + args + ")})()")
        def ready(view, result, *_):
            if self.destroyed:
                return
            try:
                if generation != self.generation or not self.trusted():
                    raise ValueError("The workspace changed.")
                if hasattr(view, "evaluate_javascript_finish"):
                    value = view.evaluate_javascript_finish(result)
                else:
                    value = view.run_javascript_finish(result).get_js_value()
                if not value.is_string():
                    raise ValueError("Waiting for the Studio editor.")
                data = json.loads(value.to_string())
                if not data.get("ok"):
                    raise ValueError(data.get("error") or "Studio could not complete the operation.")
                ticket = data.get("pending")
                if type(ticket) is int and (pending or action in ("open", "preview")):
                    def poll():
                        if generation == self.generation and not self.destroyed:
                            self.js("result", {"id": ticket}, done, pending=True)
                        elif not self.destroyed:
                            done(None, "The workspace changed.")
                        return False
                    GLib.timeout_add(60, poll)
                    return
                if "value" not in data:
                    raise ValueError("Unexpected editor response.")
            except (GLib.Error, ValueError, TypeError, AttributeError) as err:
                done(None, str(err))
                return
            done(data["value"], None)
        if hasattr(self.view, "evaluate_javascript"):
            self.view.evaluate_javascript(script, -1, None, None, None, ready, None)
        else:
            self.view.run_javascript(script, None, ready, None)

    def refresh(self):
        if self.destroyed:
            return False
        if self.trusted() and not self.busy and not self.polling:
            self.polling = True
            revision = self.revision
            def updated(state, err):
                self.polling = False
                if self.busy or revision != self.revision:
                    return
                if err:
                    self.status.set_text(err)
                else:
                    self.show_state(state)
            self.js("state", {}, updated)
        return True

    def show_state(self, state):
        objects = state["objects"]
        changed = objects != self.last.get("objects")
        self.syncing = True
        try:
            if changed:
                self.store.clear()
                for item in objects:
                    self.store.append([item["index"], item["name"]])
            model, it = self.selection.get_selected()
            displayed_index = model[it][0] if it is not None else -1
            if displayed_index != state["selected"]:
                self.selection.unselect_all()
                for row in self.store:
                    if row[0] == state["selected"]:
                        self.selection.select_iter(row.iter)
                        break
        finally:
            self.syncing = False
        selection = state.get("selection")
        if (selection != self.last.get("selection") or state["selected"] != self.last.get("selected")
                or "selection" not in self.last):
            for widget in (self.move_x, self.move_y, self.move_button):
                widget.set_sensitive(bool(selection))
            if selection:
                self.move_x.set_value(selection["x"])
                self.move_y.set_value(selection["y"])
                self.properties.set_text(f"{selection['name']}\n{selection['width']:.2f} × {selection['height']:.2f} mm")
            else:
                self.properties.set_text("Select an object")
        self.last = state
        self.set_title(("• " if state.get("dirty") else "") + state["title"] + " — KerfKite Studio")
        self.status.set_text(f"{state.get('mode', '')}   ·   {len(objects)} objects")

    def open_authoring(self, action):
        if not self.busy:
            self.view.grab_focus()
            self.command(action)

    def command(self, action, payload=None, success=None):
        if self.busy:
            return
        self.busy = True
        self.revision += 1
        def completed(value, err):
            self.busy = False
            if err:
                self.error(err)
            elif success:
                success(value)
            self.refresh()
        self.js(action, payload or {}, completed)

    def error(self, message):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.ERROR,
                                   buttons=Gtk.ButtonsType.CLOSE, text="Studio could not complete the operation")
        dialog.format_secondary_text(str(message))
        dialog.run()
        dialog.destroy()

    def confirm_discard(self, verb):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.NONE, text="Discard unsaved project changes?")
        dialog.format_secondary_text("Save the project first to keep your edits.")
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button(verb, Gtk.ResponseType.ACCEPT)
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.ACCEPT

    def guarded(self, verb, proceed, closing=False):
        if self.busy:
            return
        if closing and not self.trusted():
            if not self.last.get("dirty") or self.confirm_discard(verb):
                proceed()
            return
        self.busy = True
        def checked(state, err):
            self.busy = False
            if err and not closing:
                self.error(err)
                return
            if err and closing:
                state = {"dirty": bool(self.last)}
            if not state.get("dirty") or self.confirm_discard(verb):
                proceed()
        self.js("state", {}, checked)

    def new(self):
        self.guarded("Discard and create", lambda: self.command("new"))

    def close_requested(self, *_):
        self.guarded("Discard and close", self.destroy, closing=True)
        return True

    def on_destroy(self, *_):
        self.destroyed = True
        GLib.source_remove(self.timer)
        for win in tuple(self.active_popups):
            win.destroy()
        if Gtk.main_level():
            Gtk.main_quit()

    def choose(self, title, saving=False, name="", pattern="*", folder=None):
        kind = Gtk.FileChooserAction.SAVE if saving else Gtk.FileChooserAction.OPEN
        dialog = Gtk.FileChooserDialog(title, self, kind)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save" if saving else "Open", Gtk.ResponseType.ACCEPT)
        dialog.set_default_response(Gtk.ResponseType.ACCEPT)
        dialog.set_local_only(True)
        if folder and Path(folder).is_dir():
            dialog.set_current_folder(str(folder))
        if saving:
            dialog.set_do_overwrite_confirmation(True)
            dialog.set_current_name(Path(name or "design").name)
        filt = Gtk.FileFilter()
        filt.set_name("Project files (*.json)" if pattern == "*.json" else pattern)
        filt.add_pattern(pattern)
        dialog.add_filter(filt)
        if pattern != "*":
            other = Gtk.FileFilter()
            other.set_name("All files")
            other.add_pattern("*")
            dialog.add_filter(other)
        response = dialog.run()
        path = dialog.get_filename() if response == Gtk.ResponseType.ACCEPT else None
        dialog.destroy()
        return Path(path) if path else None

    def open(self):
        def browse():
            path = self.choose("Open project", pattern="*.json", folder=self.path.parent if self.path else None)
            if not path:
                return
            try:
                if not path.is_file():
                    raise ValueError("Choose a regular project file.")
                with path.open("rb") as src:
                    raw = src.read(PROJECT_LIMIT + 1)
                if len(raw) > PROJECT_LIMIT:
                    raise ValueError("Projects must be 4 MB or smaller.")
                content = raw.decode("utf-8-sig")
            except (OSError, ValueError) as err:
                self.error(err)
                return
            def opened(state):
                self.path, self.document = path, state["documentId"]
            self.command("open", {"content": content}, opened)
        self.guarded("Discard and open", browse)

    def save(self, save_as=False):
        def write(project):
            path = self.path if self.document == project["documentId"] and not save_as else None
            if not path:
                path = self.choose("Save project", True, project["name"], "*.json",
                                   folder=self.path.parent if self.path else None)
            if not path:
                return
            try:
                atomic_write(path, project["content"])
            except (OSError, ValueError) as err:
                self.error(err)
                return
            self.path, self.document = path, project["documentId"]
            self.command("saved", {"content": project["content"]})
        self.command("save", success=write)

    def export(self):
        def write(program):
            path = self.choose("Export G-code", True, program["name"])
            if path:
                try:
                    atomic_write(path, program["content"])
                except (OSError, ValueError) as err:
                    self.error(err)
        self.command("export", success=write)

    def download(self, _, download):
        owner = download.get_web_view()
        if owner != self.view and not any(win.get_child() == owner for win in self.active_popups):
            download.cancel()
            return
        uri = download.get_request().get_uri()
        if not (self.auxiliary_uri(uri) or uri.startswith("blob:" + self.url) or uri.startswith("data:")):
            download.cancel()
            return
        def destination(job, suggested):
            path = self.choose("Save download", True, suggested)
            if path:
                job.set_allow_overwrite(True)
                job.set_destination(path.as_uri())
            else:
                job.cancel()
            return True
        def failed(job, error):
            if not self.destroyed and not error.matches(WebKit2.download_error_quark(),
                                                        WebKit2.DownloadError.CANCELLED_BY_USER):
                self.error(error.message)
        download.connect("decide-destination", destination)
        download.connect("failed", failed)


def main(args):
    if len(args) != 1:
        raise SystemExit("Usage: kerfkite-native http://127.0.0.1:PORT/")
    window = Workbench(args[0])
    window.show_all()
    Gtk.main()


if __name__ == "__main__":
    main(sys.argv[1:])
